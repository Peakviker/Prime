# HTTP Basic credentials for the eve channel's route-auth fallback.
# Set both in the Vercel project (Settings > Environment Variables, for
# Production/Preview/Development) to allow direct HTTP calls to this agent
# from outside Vercel-to-Vercel traffic (vercelOidc) and local dev
# (localDev). Until both are set, non-Vercel/non-local HTTP requests get a
# 401 — see agent/channels/eve.ts and
# node_modules/eve/docs/guides/auth-and-route-protection.md.
ROUTE_AUTH_BASIC_USERNAME=
ROUTE_AUTH_BASIC_PASSWORD=
