# ─────────────────────────────────────────────────────────────────────────
# Route auth (agent/channels/eve.ts)
# ─────────────────────────────────────────────────────────────────────────
# HTTP Basic credentials for the eve channel's route-auth fallback. Until
# both are set, HTTP callers that are neither Vercel-to-Vercel (vercelOidc)
# nor local dev (localDev) get a 401. Required once the agent is self-hosted,
# where vercelOidc() no longer authenticates anything.
ROUTE_AUTH_BASIC_USERNAME=
ROUTE_AUTH_BASIC_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────
# Telegram channel (agent/channels/telegram.ts)
# ─────────────────────────────────────────────────────────────────────────
# From BotFather. Without it the channel mounts but cannot deliver.
TELEGRAM_BOT_TOKEN=
# Must match the secret_token passed to setWebhook. Inbound updates that
# fail this check are rejected with 401.
TELEGRAM_WEBHOOK_SECRET_TOKEN=
# Optional: only needed so the bot recognizes @mentions in group chats.
TELEGRAM_BOT_USERNAME=

# ─────────────────────────────────────────────────────────────────────────
# Hyperliquid (agent/lib/hyperliquid.ts)
# ─────────────────────────────────────────────────────────────────────────
# Set to 1 to point the read client at testnet instead of mainnet.
HYPERLIQUID_TESTNET=

# ─────────────────────────────────────────────────────────────────────────
# Self-hosted only (not needed on Vercel, where OIDC covers this)
# ─────────────────────────────────────────────────────────────────────────
# Required to route string model IDs through the Vercel AI Gateway from a
# non-Vercel host. Note that `eve build` itself reaches the gateway catalog,
# so the build environment needs this too.
AI_GATEWAY_API_KEY=

# Workflow world (agent/agent.ts, @workflow/world-postgres). Backs durable
# session state so a run survives a process restart — see deploy/README.md.
# Defaults to docker-compose.yml's postgres service credentials.
WORKFLOW_POSTGRES_URL=postgres://world:world@localhost:5432/world
